{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json","**/.*","**/node_modules/**"],
    "rewrites": [
      {"source": "/api/**", "function": {"functionId": "api", "region": "us-central1"}},
      {"source": "**", "destination": "/index.html"}
    ]
  },
  "functions": {"source": "functions"}
}
