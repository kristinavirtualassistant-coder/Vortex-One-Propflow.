rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global helper validation primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Hardened entity validation helpers
    function isValidMaintenanceRequest(data) {
      return data.keys().hasAll(['title', 'description', 'status'])
        && data.title is string && data.title.size() <= 100
        && data.description is string && data.description.size() <= 2000
        && data.status is string && data.status in ['pending', 'assigned', 'completed', 'in_progress', 'resolved'];
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'name'])
        && data.email is string && data.email.size() <= 200
        && data.name is string && data.name.size() <= 200;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['action', 'details'])
        && data.action is string && data.action.size() <= 100
        && data.details is string && data.details.size() <= 1000;
    }

    // Simple schema validators for auxiliary collections
    function isValidFinanceAnalytics(data) {
      return data.keys().hasAll(['metric', 'value']) && data.metric is string;
    }

    function isValidRecurringUpkeep(data) {
      return data.keys().hasAll(['title', 'frequency']) && data.title is string && data.frequency is string;
    }

    function isValidPropertyDocument(data) {
      return data.keys().hasAll(['name', 'url']) && data.name is string && data.url is string;
    }

    function isValidUtilityBill(data) {
      return data.keys().hasAll(['type', 'amount']) && data.type is string;
    }

    function isValidLeaseDocument(data) {
      return data.keys().hasAll(['name', 'url']) && data.name is string && data.url is string;
    }

    function isValidVendor(data) {
      return data.keys().hasAll(['companyName']) && data.companyName is string;
    }

    function isValidLease(data) {
      return data.keys().hasAll(['tenantName', 'rentAmount']) && data.tenantName is string;
    }

    function isValidUploadedDocument(data) {
      return data.keys().hasAll(['fileName', 'fileUrl']) && data.fileName is string && data.fileUrl is string;
    }

    function isValidRentalIncomeTrend(data) {
      return data.keys().hasAll(['month', 'income']) && data.month is string;
    }

    // Rules matching
    match /users/{userId} {
      allow read: if true;
      allow create: if isValidId(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && isValidUser(incoming())
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatarUrl', 'updatedAt'])
        );
      allow delete: if false;
    }

    match /maintenance_requests/{requestId} {
      allow read: if true;
      allow create: if isValidId(requestId) && isValidMaintenanceRequest(incoming());
      allow update: if isValidId(requestId) && isValidMaintenanceRequest(incoming())
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'priority', 'category', 'categories', 'updatedAt'])
        );
      allow delete: if isValidId(requestId);
    }

    match /activity_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && isValidActivityLog(incoming());
      allow update, delete: if false;
    }

    match /finance_analytics/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidFinanceAnalytics(incoming());
      allow delete: if true;
    }

    match /recurring_upkeep_schedules/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidRecurringUpkeep(incoming());
      allow delete: if true;
    }

    match /property_documents/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidPropertyDocument(incoming());
      allow delete: if true;
    }

    match /utility_bills/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidUtilityBill(incoming());
      allow delete: if true;
    }

    match /lease_documents/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidLeaseDocument(incoming());
      allow delete: if true;
    }

    match /vendors/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidVendor(incoming());
      allow delete: if true;
    }

    match /leases/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidLease(incoming());
      allow delete: if true;
    }

    match /uploaded_documents/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidUploadedDocument(incoming());
      allow delete: if true;
    }

    match /rental_income_trends/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidRentalIncomeTrend(incoming());
      allow delete: if true;
    }
  }
}
