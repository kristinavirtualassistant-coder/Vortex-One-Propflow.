rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }

    match /users/{userId} {
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role in ['tenant', 'property_manager'];
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin();
    }

    match /maintenance_requests/{requestId} {
      allow read: if isAdmin() || isRole('property_manager') || isRole('landlord') || isRole('technician')
        || (isRole('tenant') && resource.data.tenantId == request.auth.uid);
      allow create: if isAuthenticated()
        && (isRole('property_manager') || isRole('landlord') || isRole('tenant'));
      allow update: if isAdmin()
        || isRole('property_manager')
        || isRole('technician')
        || (isRole('tenant') && resource.data.tenantId == request.auth.uid);
      allow delete: if isAdmin() || isRole('property_manager');
    }

    match /properties/{propertyId} {
      allow read: if isAdmin() || isRole('property_manager') || isRole('landlord');
      allow create: if isAdmin() || isRole('property_manager') || isRole('landlord');
      allow update: if isAdmin() || isRole('property_manager') || isRole('landlord');
      allow delete: if isAdmin() || isRole('property_manager');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
