# Server-side AI
GEMINI_API_KEY=""

# Public URL used for OAuth redirect URIs.
APP_URL="https://vortexone-propflow.vercel.app"

# Application PostgreSQL connection.
# Prefer DATABASE_URL in hosted environments.
DATABASE_URL=""

# Or use discrete PostgreSQL settings:
SQL_HOST=""
SQL_PORT="5432"
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""

# OAuth provider credentials. Keep client secrets only in Vercel Environment Variables.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Session/OAuth state signing secret. Set a long random value in production.
AUTH_SESSION_PEPPER=""
SOCIAL_AUTH_PEPPER=""
