# Production PostgreSQL connection. Use the exact Supabase Connect-panel URI.
# For Vercel/serverless, use the Supabase Shared Pooler transaction/session URI as appropriate.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public URL used for OAuth redirect URIs.
APP_URL="https://vortexone-propflow.vercel.app"

# OAuth provider credentials. Keep client secrets only in Vercel Environment Variables.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
