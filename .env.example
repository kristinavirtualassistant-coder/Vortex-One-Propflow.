# Canonical production database.
# Set DATABASE_URL in Vercel Environment Variables using the connection URI
# shown in the Supabase project's Connect panel.
DATABASE_URL=""

# Optional discrete PostgreSQL settings for non-Vercel environments.
# DATABASE_URL is preferred.
SQL_HOST=""
SQL_PORT="5432"
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_SSL="true"

# Server-side AI.
GEMINI_API_KEY=""

# Public URL used for OAuth redirect URIs.
APP_URL="https://vortexone-propflow.vercel.app"

# OAuth provider credentials. Keep client secrets only in Vercel Environment Variables.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Auth0 Universal Login. Keep the client secret server-side only.
AUTH0_DOMAIN=""
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""

# Required for OAuth state signing in production.
AUTH_SESSION_PEPPER=""

# 3Min API webhook authentication. Keep these server-side only.
# Configure the matching secret/token in the 3Min webhook receiver settings.
THREEMIN_WEBHOOK_SECRET=""
THREEMIN_WEBHOOK_TOKEN=""
THREEMIN_WEBHOOK_ALLOW_UNAUTHENTICATED="false"
SOCIAL_AUTH_PEPPER=""
