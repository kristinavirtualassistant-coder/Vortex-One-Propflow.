# Canonical production database.
# Use the Supabase connection URI from the project's Connect panel.
# For serverless deployments, prefer the Supabase pooler URI.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres"

# Optional discrete PostgreSQL settings for non-Vercel environments.
# DATABASE_URL is preferred.
SQL_HOST=""
SQL_PORT="5432"
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_SSL="true"

# Server-side AI.
GEMINI_API_KEY=""

# Public URL used for OAuth redirect URIs.
APP_URL="https://vortexone-propflow.vercel.app"

# OAuth provider credentials. Keep client secrets only in Vercel Environment Variables.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Required for OAuth state signing in production.
AUTH_SESSION_PEPPER=""
SOCIAL_AUTH_PEPPER=""
