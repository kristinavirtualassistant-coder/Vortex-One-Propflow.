# Server-side AI
GEMINI_API_KEY=""

# Public URL used for OAuth redirect URIs.
APP_URL="https://vortex-one-propflow.web.app"

# Application PostgreSQL connection.
# Prefer DATABASE_URL in hosted environments.
DATABASE_URL=""

# Or use discrete PostgreSQL settings:
SQL_HOST=""
SQL_PORT="5432"
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""

# Optional PostgreSQL TLS configuration for hosted databases.
# Prefer DATABASE_SSL_CA with the provider CA certificate.
DATABASE_SSL_CA=""
# Emergency compatibility only; keep false unless the provider certificate chain
# cannot be installed in the runtime.
DATABASE_SSL_REJECT_UNAUTHORIZED=""

# Max PostgreSQL pool connections per instance (default 10). Keep within the provider limit.
DATABASE_POOL_MAX=""

# OAuth provider credentials. Keep client secrets only in Firebase Functions environment configuration.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""


# Required for OAuth state signing in production.
AUTH_SESSION_PEPPER=""

# 3Min API webhook authentication. Keep these server-side only.
# Configure the matching secret/token in the 3Min webhook receiver settings.
THREEMIN_WEBHOOK_SECRET=""
THREEMIN_WEBHOOK_TOKEN=""
THREEMIN_WEBHOOK_ALLOW_UNAUTHENTICATED="false"
SOCIAL_AUTH_PEPPER=""

# GIS Cloud integration is executed by the Supabase Edge Function.
# Store GIS_CLOUD_API_KEY only in Supabase Edge Function Secrets.
SUPABASE_URL="https://pkapasimwvbprpxhhboj.supabase.co"
GIS_CLOUD_MAP_ID="3302957"
GIS_CLOUD_LAYER_ID="7986496"
