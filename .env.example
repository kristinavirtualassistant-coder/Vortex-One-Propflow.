# Server-side AI
GEMINI_API_KEY=""

# Public URL used for OAuth redirect URIs.
APP_URL="https://vortex-one-propflow.web.app"

# Application PostgreSQL connection.
# Prefer DATABASE_URL in hosted environments.
DATABASE_URL=""

# Or use discrete PostgreSQL settings:
SQL_HOST=""
SQL_PORT="5432"
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""

# Optional PostgreSQL TLS configuration for hosted databases.
# Prefer DATABASE_SSL_CA with the provider CA certificate.
DATABASE_SSL_CA=""
# Certificate verification is on by default. Set to "false" only as an explicit,
# emergency opt-out when the provider CA cannot be supplied via DATABASE_SSL_CA.
DATABASE_SSL_REJECT_UNAUTHORIZED=""

# Max PostgreSQL pool connections per instance (default 10). Keep within the provider limit.
DATABASE_POOL_MAX=""

# OAuth provider credentials. Keep client secrets only in the hosting provider's secret manager.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""


# Required for OAuth state signing in production.
AUTH_SESSION_PEPPER=""

# 3Min API webhook authentication. Keep these server-side only.
# Configure the matching secret/token in the 3Min webhook receiver settings.
THREEMIN_WEBHOOK_SECRET=""
THREEMIN_WEBHOOK_TOKEN=""
THREEMIN_WEBHOOK_ALLOW_UNAUTHENTICATED="false"
SOCIAL_AUTH_PEPPER=""

# GIS Cloud integration is executed by the Supabase Edge Function.
# Store GIS_CLOUD_API_KEY only in Supabase Edge Function Secrets.
SUPABASE_URL="https://pkapasimwvbprpxhhboj.supabase.co"
GIS_CLOUD_MAP_ID="3302957"
GIS_CLOUD_LAYER_ID="7986496"

# --- Demo / sandbox mode -----------------------------------------------------
# POST /api/demo/session creates an isolated, seeded demo organization (24h TTL).
# Demo mode can never place real calls, send email/SMS or call paid services. Set to "false" to disable it.
DEMO_MODE_ENABLED="true"

# --- Dialer -------------------------------------------------------------------
# Only the simulated provider is implemented; any other value still runs simulated calls (see docs/ARCHITECTURE.md).
TELEPHONY_PROVIDER="simulated"

# --- Runtime ------------------------------------------------------------------
# Number of trusted proxies in front of the app (used for rate limiting by client IP).
TRUST_PROXY_HOPS="1"

# --- Tests (never point this at production) ------------------------------------
# PostgreSQL with supabase/migrations applied: DATABASE_URL=$TEST_DATABASE_URL npm run db:migrate:local
TEST_DATABASE_URL=""
