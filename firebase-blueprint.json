{
  "entities": {
    "MaintenanceRequest": {
      "title": "MaintenanceRequest",
      "description": "A tenant or manager submitted maintenance or service request.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["pending", "assigned", "completed"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "emergency"] },
        "category": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "propertyId": { "type": "string" }
      },
      "required": ["title", "description", "status"]
    },
    "User": {
      "title": "User",
      "description": "A user profile in Vortex One PropFlow.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["property_manager", "admin", "landlord", "tenant", "technician"] },
        "organizationId": { "type": "string" },
        "avatarUrl": { "type": "string" }
      },
      "required": ["email", "name", "role"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit log record of property actions.",
      "type": "object",
      "properties": {
        "action": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["action", "details"]
    },
    "FinanceAnalytics": {
      "title": "FinanceAnalytics",
      "description": "Analytical financial charts and metrics data.",
      "type": "object",
      "properties": {
        "metric": { "type": "string" },
        "value": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["metric", "value"]
    },
    "RecurringUpkeepSchedule": {
      "title": "RecurringUpkeepSchedule",
      "description": "Scheduled recurring upkeep and property maintenance events.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "frequency": { "type": "string" },
        "nextDue": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "frequency"]
    },
    "PropertyDocument": {
      "title": "PropertyDocument",
      "description": "Important document associated with a property.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "url"]
    },
    "UtilityBill": {
      "title": "UtilityBill",
      "description": "Utility billing tracking record.",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "dueDate": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "amount"]
    },
    "LeaseDocument": {
      "title": "LeaseDocument",
      "description": "Lease contract document data.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" }
      },
      "required": ["name", "url"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Third party utility/maintenance service vendor directory details.",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "contactName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["companyName"]
    },
    "Lease": {
      "title": "Lease",
      "description": "Property lease agreement record.",
      "type": "object",
      "properties": {
        "tenantName": { "type": "string" },
        "propertyAddress": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "rentAmount": { "type": "number" }
      },
      "required": ["tenantName", "rentAmount"]
    },
    "UploadedDocument": {
      "title": "UploadedDocument",
      "description": "A user-uploaded document or PDF attachment.",
      "type": "object",
      "properties": {
        "fileName": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileSize": { "type": "number" },
        "uploadedBy": { "type": "string" }
      },
      "required": ["fileName", "fileUrl"]
    },
    "RentalIncomeTrend": {
      "title": "RentalIncomeTrend",
      "description": "Trend analytics data for rental incomes.",
      "type": "object",
      "properties": {
        "month": { "type": "string" },
        "income": { "type": "number" }
      },
      "required": ["month", "income"]
    }
  },
  "firestore": {
    "maintenance_requests": { "schema": "MaintenanceRequest", "description": "Real-time tenant maintenance service request collection." },
    "users": { "schema": "User", "description": "User account profiles and metadata." },
    "activity_logs": { "schema": "ActivityLog", "description": "Log records of actions on the platform." },
    "finance_analytics": { "schema": "FinanceAnalytics", "description": "Analytical financial charts and metrics data." },
    "recurring_upkeep_schedules": { "schema": "RecurringUpkeepSchedule", "description": "Scheduled recurring upkeep and property maintenance events." },
    "property_documents": { "schema": "PropertyDocument", "description": "Important document associated with a property." },
    "utility_bills": { "schema": "UtilityBill", "description": "Utility billing tracking records." },
    "lease_documents": { "schema": "LeaseDocument", "description": "Lease contract document data." },
    "vendors": { "schema": "Vendor", "description": "Third party utility/maintenance service vendor directory details." },
    "leases": { "schema": "Lease", "description": "Property lease agreement records." },
    "uploaded_documents": { "schema": "UploadedDocument", "description": "A user-uploaded document or PDF attachment." },
    "rental_income_trends": { "schema": "RentalIncomeTrend", "description": "Trend analytics data for rental incomes." }
  }
}
