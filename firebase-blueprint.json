{
  "entities": {
    "MaintenanceRequest": {
      "title": "MaintenanceRequest",
      "description": "A tenant or manager submitted maintenance or service request.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 100,
          "description": "Short title or summary of the issue."
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Detailed description of the maintenance problem."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "assigned", "completed"],
          "description": "Current resolution status."
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "emergency"],
          "description": "Urgency priority level."
        },
        "category": {
          "type": "string",
          "description": "Assigned trade category."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "propertyId": {
          "type": "string",
          "description": "ID of the affected property."
        }
      },
      "required": ["title", "description", "status"]
    },
    "User": {
      "title": "User",
      "description": "A user profile in Vortex One PropFlow.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User's unique email address."
        },
        "name": {
          "type": "string",
          "description": "User's full name or display name."
        },
        "role": {
          "type": "string",
          "enum": ["property_manager", "admin", "landlord", "tenant", "technician"],
          "description": "Assigned user permission role."
        },
        "organizationId": {
          "type": "string",
          "description": "ID of the organization they belong to."
        },
        "avatarUrl": {
          "type": "string",
          "description": "Optional profile photo URL."
        }
      },
      "required": ["email", "name", "role"]
    }
  },
  "firestore": {
    "maintenance_requests": {
      "schema": "MaintenanceRequest",
      "description": "Real-time tenant maintenance service request collection."
    },
    "users": {
      "schema": "User",
      "description": "User account profiles and metadata."
    }
  }
}
